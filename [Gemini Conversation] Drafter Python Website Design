from drafter import *
from dataclasses import dataclass

# --- 1. Dataclasses ---

@dataclass
class Part:
    name: str #[cite: 4]
    material: str #[cite: 4]
    weight: float #[cite: 5]
    cost: float #[cite: 5]
    purchased: bool = False # Added based on the Purchased Status CheckBox requirement[cite: 10]

@dataclass
class State:
    parts: list[Part] #[cite: 4]
    budget: float #[cite: 4]
    current_filter: str #[cite: 4]
    status_message: str #[cite: 4]

# --- 2. Initial State ---
# Sets up the initial state for persistent data[cite: 2]
set_state(State(
    parts=[], 
    budget=1000.0, 
    current_filter="All", 
    status_message=""
))

# --- 3. Routes & Pages ---

@route("/")
def home_route(state: State) -> Page:
    """Home Dashboard Page: Provides an overview of the prototype[cite: 8]."""
    total_parts = len(state.parts)
    
    # Loop requirement: iterates through every Part instance to sum weights and costs[cite: 10]
    total_weight = 0.0
    total_cost = 0.0
    for part in state.parts:
        total_weight += part.weight
        total_cost += part.cost
        
    return Page(
        state,
        [
            Header("Mechanical Prototype Dashboard"),
            Text(f"Total Parts: {total_parts}"),
            Text(f"Combined Weight: {total_weight} lbs"),
            Text(f"Current Budget Health: ${total_cost} / ${state.budget}"),
            Button("View Inventory", inventory_route),
            Button("Add New Part", add_part_form_route),
            Button("Budget Calculator", calculator_route),
            Button("About", about_route)
        ]
    )

@route("/parts")
def inventory_route(state: State) -> Page:
    """Inventory Page: Displays a structured listing of mechanical components[cite: 5]."""
    # Material Category Filtering IF statement[cite: 10]
    filtered_parts = []
    for part in state.parts:
        if state.current_filter == "All" or part.material == state.current_filter:
            filtered_parts.append(part)

    content = [
        Header("Project Inventory"),
        Button("Back to Home", home_route),
        SelectBox("current_filter", ["All", "Aluminum", "Steel", "Brass"], state.current_filter),
        Button("Filter", inventory_route)
    ]

    for p in filtered_parts:
        content.append(Text(f"- {p.name} ({p.material}): {p.weight} lbs, ${p.cost}"))

    return Page(state, content)

@route("/add_part_form")
def add_part_form_route(state: State) -> Page:
    """Add Part Form Page: Houses the input form for new components[cite: 8]."""
    return Page(
        state,
        [
            Header("Add New Component"),
            Text(state.status_message),
            # TextBox for name and weight[cite: 9]
            TextBox("part_name", "Enter Part Name"),
            TextBox("part_weight", "Enter Weight (lbs)"),
            TextBox("part_cost", "Enter Cost ($)"),
            # SelectBox for Material Category[cite: 9]
            SelectBox("part_material", ["Aluminum", "Steel", "Brass"], "Aluminum"),
            # CheckBox for Purchased Status[cite: 10]
            CheckBox("is_purchased", "Item has been purchased/ordered", False),
            Button("Save Part", add_part_action),
            Button("Cancel", home_route)
        ]
    )

@route("/add_part")
def add_part_action(state: State, part_name: str, part_weight: str, part_cost: str, part_material: str, is_purchased: bool) -> Page:
    """Processes the submitted part form[cite: 8]."""
    # Form Validation Check IF statement[cite: 10]
    if part_name == "" or part_name.isspace():
        state.status_message = "Error: Part name cannot be empty."
        return add_part_form_route(state)
    
    try:
        weight_val = float(part_weight)
        cost_val = float(part_cost)
    except ValueError:
        state.status_message = "Error: Weight and Cost must be numbers."
        return add_part_form_route(state)

    new_part = Part(
        name=part_name, 
        material=part_material, 
        weight=weight_val, 
        cost=cost_val, 
        purchased=is_purchased
    )
    # Append newly created Part instance to the list[cite: 7]
    state.parts.append(new_part)
    state.status_message = f"Success: {part_name} added to inventory."
    
    return home_route(state)

@route("/calculator")
def calculator_route(state: State) -> Page:
    """Calculator Page: Evaluates weight and cost against budget and displays alerts[cite: 8]."""
    total_cost = sum(p.cost for p in state.parts)
    
    # Budget Limit Alert IF statement[cite: 10]
    if total_cost > state.budget:
        state.status_message = "WARNING: Maximum allowable budget exceeded!"
    else:
        state.status_message = "Budget is currently within limits."

    return Page(
        state,
        [
            Header("Budget & Weight Calculator"),
            Text(state.status_message),
            Text(f"Total Expenditure: ${total_cost}"),
            Text(f"Current Budget: ${state.budget}"),
            TextBox("new_budget", str(state.budget)),
            Button("Update Budget Limit", update_budget_action),
            Button("Back to Home", home_route)
        ]
    )

@route("/update_budget")
def update_budget_action(state: State, new_budget: str) -> Page:
    """Processes the new budget limit[cite: 8]."""
    try:
        state.budget = float(new_budget)
    except ValueError:
        pass
    return calculator_route(state)

@route("/about")
def about_route(state: State) -> Page:
    """About Page: Outlines the purpose of the tool and navigation instructions[cite: 8]."""
    return Page(
        state,
        [
            Header("About This Tool"),
            Text("This site is a place where engineers working on projects can input their required materials and tools to get a total cost, weight, and other stats about their project[cite: 4]."),
